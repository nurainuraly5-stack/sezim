# Sezim — переменные окружения (только сервер). Скопируйте в .env.local.
# Без ключей всё работает: текст — fallback-движок, озвучка — голос браузера.

# LLM-анализ текста: anthropic | none
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
# необязательно, по умолчанию claude-opus-5-5
LLM_MODEL=

# Озвучка (предрендер mp3): openai | elevenlabs | none
TTS_PROVIDER=none
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# необязательно: gpt-4o-mini-tts / eleven_multilingual_v2
TTS_MODEL=
